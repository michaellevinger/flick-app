{
  "expo": {
    "name": "Flick",
    "slug": "flick-fresh-dev",
    "version": "1.0.0",
    "orientation": "portrait",
    "privacy": "public",
    "privacyPolicyUrl": "https://www.helloflick.com/privacy.html",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.michaellevinger.flick",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "flick needs camera access to take your profile photo and scan event QR codes",
        "NSPhotoLibraryUsageDescription": "flick needs photo library access to select profile photos",
        "NSLocationWhenInUseUsageDescription": "flick uses your location to show you singles nearby at your event (within 500m)"
      }
    },
    "android": {
      "package": "com.michaellevinger.flick",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B9D"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supabaseUrl": "https://oithyuuztrmohcbfglrh.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9pdGh5dXV6dHJtb2hjYmZnbHJoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njk5Mjc4MDIsImV4cCI6MjA4NTUwMzgwMn0.Ph8Z1YMFjwxir1_EBjPpeZZF8igjH9bUvC4fdZozvIY",
      "eas": {
        "projectId": "1cb1f50a-b9e2-4963-84fb-9158b26e58af"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-camera",
      "expo-location",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ]
    ]
  }
}
