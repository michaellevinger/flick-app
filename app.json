{
  "expo": {
    "name": "Flick",
    "slug": "flick-fresh-dev",
    "scheme": "flick",
    "version": "1.0.0",
    "orientation": "portrait",
    "privacy": "public",
    "privacyPolicyUrl": "https://www.helloflick.com/privacy.html",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.michaellevinger.flick",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "flick needs camera access to take your profile photo and scan event QR codes",
        "NSPhotoLibraryUsageDescription": "flick needs photo library access to select profile photos",
        "NSUserNotificationUsageDescription": "flick notifies you when someone flicks you, you get a match, or you receive a message."
      }
    },
    "android": {
      "package": "com.michaellevinger.flick",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B9D"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "helloflick.com",
              "pathPrefix": "/join/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supabaseUrl": "https://oithyuuztrmohcbfglrh.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9pdGh5dXV6dHJtb2hjYmZnbHJoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Njk5Mjc4MDIsImV4cCI6MjA4NTUwMzgwMn0.Ph8Z1YMFjwxir1_EBjPpeZZF8igjH9bUvC4fdZozvIY",
      "googleWebClientId": "1027703361731-n0v1i623canukidhlmg3ibcbbu2vvrd5.apps.googleusercontent.com",
      "eas": {
        "projectId": "9f89cff3-c8cc-46b4-ae32-43dad62fbd26"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-camera",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C44CE0",
          "androidMode": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "owner": "dorbiren"
  }
}
