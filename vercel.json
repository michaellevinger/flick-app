{
  "version": 2,
  "name": "flick",
  "builds": [
    {
      "src": "website/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/weddings/waitlist",
      "dest": "/website/weddings/waitlist.html"
    },
    {
      "src": "/(.*)",
      "dest": "/website/$1"
    }
  ]
}
